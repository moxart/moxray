{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoxRay",
  "version": "0.1.0",
  "identifier": "dev.moxart.moxray",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MoxRay",
        "width": 1040,
        "height": 700,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "publisher": "Patrick Der Avakians",
    "copyright": "Copyright (c) 2026 Patrick Der Avakians",
    "shortDescription": "Proxy client for Xray-core",
    "longDescription": "MoxRay is a desktop client for Xray-core: import servers and subscriptions, switch automatically when a server fails, and set the system proxy.",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "homepage": "https://github.com/moxart/moxray",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Persian"
        ]
      }
    }
  }
}
