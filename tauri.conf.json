{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoxRay",
  "version": "0.1.0",
  "identifier": "dev.moxart.moxray",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MoxRay",
        "width": 1040,
        "height": 700,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Network"
  }
}
